# PostgreSQL connection URL used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seischat

# Environment name used for local/deployed configuration.
APP_ENVIRONMENT=development

# Exact browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173

# Cookie/session settings.
SESSION_COOKIE_NAME=seischat_session
CSRF_COOKIE_NAME=seischat_csrf
SESSION_TTL_MINUTES=60
# Set true when serving over HTTPS outside local development.
CSRF_SECURE=false
